# UI dev server port (Vite)
VITE_PORT=7001

# API base URL used by request utility and Vite /dev-api proxy target
VITE_API_BASE_URL=http://localhost:8080

# Microsoft Entra ID app registration
# Add the real values in ui-2/.env (do not commit secrets or tenant-specific values)
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here

# Personal ports example (shared server safe)
# VITE_PORT=5174
# VITE_API_BASE_URL=http://localhost:9091
