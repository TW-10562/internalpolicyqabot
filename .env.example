# ================================================================
# HR Bot - Environment Configuration
# ================================================================
# Copy this file to .env and fill in all required values.
# NEVER commit .env with real secrets to version control.
# ================================================================

# =========================
# PostgreSQL
# =========================
DATABASE_URL=postgresql://twave_01:CHANGE_ME_PG_PASSWORD@localhost:5432/qa_db
PG_HOST=localhost
PG_PORT=5432
PG_USER=twave_01
PG_PASSWORD=CHANGE_ME_PG_PASSWORD
PG_DATABASE=qa_db
PG_SSL=false
DB_MODE=postgres

# =========================
# Redis
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# =========================
# JWT Secrets (REQUIRED - must be ≥16 chars in production)
# =========================
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_16_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_MIN_16

# =========================
# Apache Solr
# =========================
SOLR_URL=http://localhost:8983
SOLR_CORE_NAME=mycore

# =========================
# LLM / Model Configuration
# =========================
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=gpt-oss:120b
CHAT_MODEL_NAME=gpt-oss:120b
CHAT_TITLE_MODEL_NAME=gpt-oss:120b
CHAT_KEYWORD_MODEL_NAME=gpt-oss:120b
SUMMARY_MODEL_NAME=gpt-oss:120b
TRANSLATE_MODEL_NAME=gpt-oss:120b
LLM_BASE_URL_OVERRIDE=http://host.docker.internal:9080/v1
LLM_MODEL=gpt-oss:20b

# =========================
# RAG Configuration
# =========================
RAG_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
RAG_RERANK_MODEL=hotchpotch/japanese-bge-reranker-v2-m3-v1
# Retrieval index language mode: multi | en | ja
RAG_INDEX_LANGUAGE=multi
RAG_BACKEND_HOST=127.0.0.1
RAG_BACKEND_PORT=8010
RAG_BACKEND_URL=http://localhost:8010
RAG_SERVICE_URL=http://localhost:8010
RAG_FORCE_GPU_ONLY=0
FAQ_CACHE_API_URL=http://localhost:8001

# Embedding dimension (auto-detected for known models; set explicitly if using custom model)
# RAG_VECTOR_EMBEDDING_DIMENSION=4096
# RAG_VECTOR_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
# RAG_BACKEND_COLLECTION_NAME=splitByArticleWithHybridSearch

# =========================
# RAG Tuning (optional - sensible defaults)
# =========================
# RAG_SOLR_TIMEOUT_MS=12000
# RAG_BACKEND_TIMEOUT_MS=6000
# RAG_SOLR_ROWS=20
# RAG_SOLR_MAX_CALLS=8
# RAG_HYBRID_SOLR_WEIGHT=0.6
# RAG_HYBRID_VECTOR_WEIGHT=0.4
# RAG_CONTEXT_MAX_TOKENS=1500
# RAG_MAX_DOCUMENTS=2
# RAG_MAX_EVIDENCE_CHUNKS=3
# RAG_RESPONSE_CACHE_ENABLED=1
# RAG_RESPONSE_CACHE_TTL_MS=600000
# RAG_LLM_TIMEOUT_MS=60000

# Smart chunking (splitByArticleWithHybridSearch mode)
# RAG_SMART_CHUNK_SIZE_TOKENS=500
# RAG_SMART_CHUNK_OVERLAP_TOKENS=80

# =========================
# Frontend / Backend Networking
# =========================
FRONTEND_HOST=localhost
FRONTEND_PORT=7001
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
WEB_PORT=7001
WEB_TLS_PORT=443
API_PORT=8080
PUBLIC_BASE_URL=https://policybot.twave.co.jp
# PUBLIC_API_BASE_URL=

# UI local dev overrides (used by ui-2/vite)
VITE_PORT=7001
VITE_API_BASE_URL=http://localhost:8080

# =========================
# Microsoft Azure AD SSO (REQUIRED for SSO login)
# =========================
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=https://policybot.twave.co.jp/dev-api/user/auth/callback

# =========================
# Deployment
# =========================
NODE_ENV=production
APP_MODE=production
# TZ=Asia/Tokyo
